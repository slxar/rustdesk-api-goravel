{{if .Items}}<div class="table-wrap" role="region" aria-label="{{.Title}} table" tabindex="0"><table><thead><tr>{{range .Columns}}<th scope="col">{{.}}</th>{{end}}</tr></thead><tbody>{{range .Items}}<tr>{{range .}}<td>{{.}}</td>{{end}}</tr>{{end}}</tbody></table></div>{{else}}<section class="empty" role="status"><h2>No results</h2><p>Try a different filter or add data through the supported API.</p></section>{{end}}{{if .Path}}<nav class="pagination" aria-label="Pagination"><span>Page {{.Page}} · {{.Total}} results</span>{{if .PreviousURL}}<a href="{{.PreviousURL}}" hx-get="{{.PreviousURL}}" hx-target="#results" hx-push-url="true" hx-indicator="#loading">Previous</a>{{end}}{{if .NextURL}}<a href="{{.NextURL}}" hx-get="{{.NextURL}}" hx-target="#results" hx-push-url="true" hx-indicator="#loading">Next</a>{{end}}</nav>{{end}}
