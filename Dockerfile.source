FROM golang:1.25-alpine AS build
RUN apk add --no-cache gcc musl-dev
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -o /out/apimain ./cmd

FROM alpine:3.22
RUN apk add --no-cache tzdata ca-certificates
WORKDIR /app
COPY --from=build /out/apimain /app/apimain
COPY conf /app/conf
COPY resources /app/resources
COPY public /app/public
RUN mkdir -p /app/runtime /app/data
VOLUME /app/data
EXPOSE 21114
CMD ["./apimain"]
